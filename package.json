{
    "name": "bricksumo",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Capa de comunicación Pybricks para BRICKSUMO: BLE, USB, firmware y programas.",
    "license": "MIT",
    "engines": {
        "node": ">=22.12.0"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./protocol": {
            "types": "./dist/protocol/index.d.ts",
            "import": "./dist/protocol/index.js"
        }
    },
    "files": [
        "dist",
        "docs",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "build:site": "node scripts/check-site.mjs",
        "check:no-storage": "node scripts/check-no-storage.mjs",
        "cli": "tsx src/cli/main.ts",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "verify": "npm run check:no-storage && npm run typecheck && npm run lint && npm run test && npm run build"
    },
    "dependencies": {
        "@pybricks/firmware": "7.27.0",
        "dfu": "0.1.5"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "26.6.6",
        "@types/w3c-web-usb": "1.0.14",
        "@types/web-bluetooth": "0.0.22",
        "eslint": "10.14.0",
        "globals": "17.14.0",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    }
}
